# ============================================================================
#  timbafulbo — environment variables template
# ----------------------------------------------------------------------------
#  Copy this file to `.env` for local development:
#    cp .env.example .env
#  Each variable is annotated with the scope(s) where it is needed:
#    [local]   = your local machine (.env)
#    [vercel]  = Vercel project env vars (Production / Preview)
#    [gha]     = GitHub Actions secret (workflows under .github/workflows)
# ============================================================================


# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# [local] Postgres URL the Next.js app uses at runtime.
# Local example (no Supabase):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/timbafulbo?schema=public"

# [vercel] On Vercel set DATABASE_URL to the Supabase **Transaction Pooler** URL:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require

# [gha] In GitHub Actions, the WC sync workflow uses DATABASE_URL as a repo secret.
#       Use the Supabase **Session Pooler** URL (port 5432) so it works on IPv4 runners:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require


# ----------------------------------------------------------------------------
# Migrations (used by `pnpm prisma:migrate:deploy` and the migrate workflow)
# ----------------------------------------------------------------------------

# [gha] Required only by the production migration workflow.
#       Use the Supabase **Session Pooler** URL (port 5432) — NOT the transaction
#       pooler (6543), and NOT `db.<ref>.supabase.co` (IPv6-only without the
#       Supabase IPv4 add-on).
# REMOTE_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# [local] Safety flag for `pnpm prisma:migrate:deploy`. Keep "false" locally.
#         The GitHub Actions migrate workflow sets this to "true" itself.
ALLOW_REMOTE_MIGRATION="false"


# ----------------------------------------------------------------------------
# Better Auth (Google OAuth only)
# ----------------------------------------------------------------------------

# [local|vercel] Public origin of the app. No trailing slash.
#   - local:  http://localhost:3000
#   - vercel: https://<your-domain-or-vercel-url>
BETTER_AUTH_URL="http://localhost:3000"

# [local|vercel] Random secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<generate-with: openssl rand -base64 32>"

# [local|vercel] Google Cloud OAuth client. The OAuth client must list these
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-prod-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"


# ----------------------------------------------------------------------------
# Resend (email invitations) — OPTIONAL
# ----------------------------------------------------------------------------
# When RESEND_API_KEY is unset, invitation emails are SKIPPED (the action still
# creates `Invitation` rows; share the invite code or link manually). Leave both
# unset until you actually want email invites; then set them in [vercel] too.

# [local|vercel] Resend API key. Leave unset to disable email sending.
# RESEND_API_KEY="<resend-api-key>"

# [local|vercel] Verified Resend sender. Until you verify a domain, use the
# Resend sandbox sender (only delivers to your own verified email):
#   "timbafulbo <onboarding@resend.dev>"
# Defaults (in env.ts) to the sandbox value above for UI display purposes.
# INVITE_FROM_EMAIL="timbafulbo <onboarding@resend.dev>"

# [local|vercel] Absolute base URL used in invite links. Falls back to
# BETTER_AUTH_URL when unset, so you usually do NOT need to set this in Vercel.
# APP_BASE_URL="http://localhost:3000"


# ----------------------------------------------------------------------------
# football-data.org
# ----------------------------------------------------------------------------

# [local|gha] Token for the X-Auth-Token header. Required by:
#   pnpm football-data:refresh:wc        (one-off cache refresh)
#   pnpm football-data:sync:wc[:full]    (live score sync, runs in GH Actions)
# Not required by the Next.js runtime — do NOT put this in Vercel.
FOOTBALL_DATA_API_TOKEN=""


# ----------------------------------------------------------------------------
# Manual rehearsal scripts (optional; only needed when running them)
# ----------------------------------------------------------------------------
# CLI scripts (seed, football-data:*, manual-test:wc:*) read .env only — not
# .env.local. Put DATABASE_URL and tokens here if you run those from the terminal.

# [local] Belt-and-suspenders flag for manual-test scripts when targeting a
# remote database. Both this AND `--allow-remote` are required to act on a
# non-local DB. Keep unset/false in normal use.
# MANUAL_TEST_ALLOW_REMOTE="false"
